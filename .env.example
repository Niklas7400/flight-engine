# Kopieren nach .env und eigenen Key eintragen (https://serpapi.com/manage-api-key)
SERPAPI_KEY=your_serpapi_key

# Supabase (ohne SUPABASE_URL wird In-Memory-Storage genutzt)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM-Zweitmeinung: gemini (Standard) | groq | none
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=

# Monatliches SerpApi-Limit (Free-Tier: 250)
SERPAPI_MONTHLY_LIMIT=250
